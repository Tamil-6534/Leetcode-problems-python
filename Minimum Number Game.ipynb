    "nums = [2,5]\n",
    "arr=[]\n",
    "length=len(nums)/2\n",
    "for i in range(int(length)):\n",
    "    min1=min(nums)\n",
    "    index1=nums.index(min1)\n",
    "    nums.pop(index1)\n",
    "\n",
    "    min2=min(nums)\n",
    "    index2=nums.index(min2)\n",
    "    nums.pop(index2)\n",
    "    arr.append(min2)\n",
    "    arr.append(min1)\n",
    "print(arr)"
   ]
  }
