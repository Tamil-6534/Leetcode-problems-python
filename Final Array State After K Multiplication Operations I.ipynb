   "source": [
    "nums = [1,2]\n",
    "k = 3\n",
    "multiplier = 4\n",
    "for i in range(k):\n",
    "    minimum=min(nums)\n",
    "    index=nums.index(minimum)\n",
    "    min_multiply=minimum*multiplier\n",
    "    nums.pop(index)\n",
    "    replace=nums.insert(index,min_multiply)\n",
    "print(nums)"
   ]
  }
