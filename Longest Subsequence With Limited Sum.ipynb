   "source": [
    "nums = [4,5,2,1]\n",
    "queries = [3,10,21]\n",
    "\n",
    "lst=[]\n",
    "nums.sort()\n",
    "\n",
    "for i in queries:\n",
    "    current,count=i,0\n",
    "    for j in nums:\n",
    "        if(j<=current):\n",
    "            current-=j\n",
    "            count+=1\n",
    "\n",
    "        else:\n",
    "            break\n",
    "    lst.append(count)\n",
    "lst"
   ]
  }
