   "source": [
    "nums = [-3,4,3,2]\n",
    "pivot = 2\n",
    "\n",
    "first=[]\n",
    "middle=[]\n",
    "last=[]\n",
    "\n",
    "length=len(nums)\n",
    "for i in range(length):\n",
    "    if(nums[i]<pivot):\n",
    "        first.append(nums[i])\n",
    "    elif(nums[i]==pivot):\n",
    "        middle.append(nums[i])\n",
    "    else:\n",
    "        last.append(nums[i])\n",
    "\n",
    "\n",
    "print(first+middle+last)"
   ]
  }
 ],
