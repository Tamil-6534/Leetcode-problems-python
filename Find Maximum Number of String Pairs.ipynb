   "source": [
    "words = [\"cd\",\"ac\",\"dc\",\"ca\",\"zz\"]\n",
    "\n",
    "reversed_words=[i[::-1] for i in words]\n",
    "\n",
    "count=0\n",
    "length=len(words)\n",
    "\n",
    "for i in range(length):\n",
    "    for j in range(i+1,length):\n",
    "        if(words[i]==reversed_words[j]):\n",
    "            count+=1\n",
    "    \n",
    "print(count)"
   ]
  }
 ],
