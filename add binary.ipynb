   ],
   "source": [
    "image = [[1,1,0,0],[1,0,0,1],[0,1,1,1],[1,0,1,0]]\n",
    "ans=[]\n",
    "for i in image:\n",
    "    sub=[]\n",
    "    for j in i:\n",
    "        if(j==1):\n",
    "            sub.append(0)\n",
    "        elif(j==0):\n",
    "            sub.append(1)\n",
    "    ans.append(sub)\n",
    "final=[k[::-1] for k in ans]\n",
    "print(final)\n"
   ]
  }
 ],
