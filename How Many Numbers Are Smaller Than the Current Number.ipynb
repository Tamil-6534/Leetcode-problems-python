   "source": [
    "nums = [8,1,2,2,3]\n",
    "lst=[]\n",
    "length=len(nums)\n",
    "count=0\n",
    "\n",
    "for i in range(length):\n",
    "    for j in range(length):\n",
    "        if(nums[i]>nums[j]):\n",
    "            count+=1\n",
    "    lst.append(count)\n",
    "    count=0\n",
    "\n",
    "lst"
   ]
  }
