   "source": [
    "nums = [1,1]\n",
    "length=len(nums)\n",
    "count=0\n",
    "\n",
    "\n",
    "for x in range(1,length+1):\n",
    "    for j in range(length):\n",
    "        if(x<=nums[j]):\n",
    "            count+=1\n",
    "    if(count==x):\n",
    "        print(count)\n",
    "        break\n",
    "    else:\n",
    "        count=0\n",
    "if(count==0):\n",
    "    print(-1)\n"
   ]
  }
