   "source": [
    "commands = [\"DOWN\",\"RIGHT\",\"UP\"]\n",
    "n = 3\n",
    "i,j=0,0\n",
    "d={\n",
    "    \"UP\": (-1, 0),\n",
    "    \"DOWN\": (1, 0),\n",
    "    \"LEFT\": (0, -1),\n",
    "    \"RIGHT\": (0, 1)\n",
    "}\n",
    "for c in commands:\n",
    "    a, b = d[c]\n",
    "    i+=a\n",
    "    j+=b\n",
    "    print( i*n+j)\n",
    "\n",
    "\n",
    "\n"
   ]
  }
 ],
