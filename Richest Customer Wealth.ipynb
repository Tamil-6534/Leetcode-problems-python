    "accounts = [[2,8,7],[7,1,3],[1,9,5]]\n",
    "lst=[]\n",
    "sum=0\n",
    "len1=len(accounts)\n",
    "len2=len(accounts[0])\n",
    "\n",
    "for i in range(len1):\n",
    "    for j in range(len2):\n",
    "        sum+=accounts[i][j]\n",
    "    lst.append(sum)\n",
    "    sum=0\n",
    "print(max(lst))"
   ]
